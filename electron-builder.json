{
  "appId": "com.polaroid.bear-budgets-test",
  "productName": "Bear Budgets Test",
  "files": ["dist-electron", "dist-react"],
  "extraResources": ["dist-electron/preload.cjs", "src/assets/**"],
  "icon": "./src/assets/bear-budgets-icon.png",
  "mac": {
    "target": "dmg"
  },
  "linux": {
    "target": "deb",
    "category": "Utility",
    "executableName": "bear-budgets-test"
  },
  "win": {
    "target": ["nsis"]
  },
  "nsis": {
    "artifactName": "Bear-Budgets-Test-Setup-${version}.${ext}"
  },
  "publish": {
    "provider": "github",
    "owner": "Pol4rLun4r",
    "repo": "github-test",
    "releaseType": "release"
  }
}